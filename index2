<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Práctica de Mecanografía</title>
  <style>
    body { font-family: sans-serif; max-width: 700px; margin: 40px auto; padding: 0 20px; color: #333; }
    textarea { width: 100%; height: 100px; margin-bottom: 10px; padding: 10px; box-sizing: border-box; }
    button { padding: 10px 15px; background: #007bff; color: white; border: none; border-radius: 4px; cursor: pointer; }
    button:hover { background: #0056b3; }
    #text-display { font-family: monospace; font-size: 1.2rem; background: #f4f4f4; padding: 15px; border-radius: 4px; line-height: 1.5; margin: 20px 0; min-height: 60px; word-wrap: break-word; }
    .correct { color: green; background-color: #e6ffe6; }
    .incorrect { color: red; background-color: #ffe6e6; }
    .current { border-bottom: 2px solid #007bff; }
    #stats { font-weight: bold; margin-top: 15px; }
  </style>
</head>
<body>

  <h1>Práctica de Mecanografía</h1>

  <label for="custom-text"><strong>Ingresa tu texto personalizado:</strong></label>
  <textarea id="custom-text" placeholder="Pega o escribe aquí el texto que quieras practicar..."></textarea>
  <button onclick="loadCustomText()">Cargar texto para practicar</button>

  <div id="text-display">Carga un texto arriba para comenzar...</div>

  <input type="text" id="input-field" placeholder="Empieza a escribir aquí..." disabled style="width: 100%; padding: 10px; font-size: 1rem; box-sizing: border-box;">

  <div id="stats">
    <span>PPM: <strong id="wpm">0</strong></span> | 
    <span>Precisión: <strong id="accuracy">100%</strong></span>
  </div>

  <script>
    let textToType = "";
    let startTime;
    let timerRunning = false;

    const display = document.getElementById('text-display');
    const input = document.getElementById('input-field');
    const wpmEl = document.getElementById('wpm');
    const accuracyEl = document.getElementById('accuracy');

    function loadCustomText() {
      const rawText = document.getElementById('custom-text').value.trim();
      if (!rawText) return;

      textToType = rawText;
      display.innerHTML = '';
      
      // Envolver cada carácter en un <span> para colorearlo después
      textToType.split('').forEach((char, index) => {
        const charSpan = document.createElement('span');
        charSpan.innerText = char;
        if (index === 0) charSpan.classList.add('current');
        display.appendChild(charSpan);
      });

      input.value = '';
      input.disabled = false;
      input.focus();
      timerRunning = false;
      wpmEl.innerText = '0';
      accuracyEl.innerText = '100%';
    }

    input.addEventListener('input', () => {
      const arrayQuote = display.querySelectorAll('span');
      const arrayValue = input.value.split('');

      if (!timerRunning && input.value.length > 0) {
        startTime = new Date();
        timerRunning = true;
      }

      let correctChars = 0;

      arrayQuote.forEach((characterSpan, index) => {
        const character = arrayValue[index];

        characterSpan.classList.remove('current');

        if (character == null) {
          characterSpan.classList.remove('correct', 'incorrect');
        } else if (character === characterSpan.innerText) {
          characterSpan.classList.add('correct');
          characterSpan.classList.remove('incorrect');
          correctChars++;
        } else {
          characterSpan.classList.add('incorrect');
          characterSpan.classList.remove('correct');
        }

        if (index === arrayValue.length) {
          characterSpan.classList.add('current');
        }
      });

      // Calcular estadísticas
      if (timerRunning && arrayValue.length > 0) {
        const timeInMinutes = (new Date() - startTime) / 60000;
        const wpm = Math.round((arrayValue.length / 5) / timeInMinutes);
        const accuracy = Math.round((correctChars / arrayValue.length) * 100);

        wpmEl.innerText = wpm > 0 && isFinite(wpm) ? wpm : 0;
        accuracyEl.innerText = (accuracy || 0) + '%';
      }
    });
  </script>

</body>
</html>
